{
  "project_name": "algorithm-lab",
  "dirs": {
    "sources": "papers",
    "src": "src",
    "tests": "tests",
    "experiments": "experiments",
    "runs": "runs",
    "journal": "journal",
    "sandbox": "sandbox",
    "agent": ".agent"
  },
  "check_commands": [
    ["python", "-m", "unittest", "discover", "-s", "tests", "-t", ".", "-p", "test_*.py"]
  ],
  "pure_layer": {
    "dir_name": "core",
    "forbidden_imports": ["os", "sys", "io", "pathlib", "subprocess", "shutil", "json", "time", "datetime", "socket", "random", "requests", "scripts"]
  },
  "budget": {
    "max_outer_iterations_per_claim": 5,
    "max_runs_per_claim": 10,
    "max_diagnostic_runs_per_claim": 3
  },
  "explore": {
    "hypothesis_types": [
      "未確定点の解釈",
      "実装の誤り",
      "実験条件",
      "評価・集計の方法",
      "統計的ばらつき",
      "資料の誤り・矛盾"
    ],
    "stagnation_window": 3,
    "min_rel_improvement": 0.1,
    "max_failed_predictions_per_type": 2
  },
  "stats": {
    "bootstrap_samples": 2000,
    "ci": 0.9,
    "min_seeds": 10
  }
}
